{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "posthop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "../outlook-addin/dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "posthop", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../db/migrations"}],
  "queues": {"producers": [{"binding": "DELIVERIES", "queue": "posthop-deliveries"}], "consumers": [{"queue": "posthop-deliveries", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 3}]},
  "triggers": {"crons": ["*/5 * * * *"]},
  "observability": {"enabled": true, "head_sampling_rate": 0.1},
  "vars": {"APP_ENV": "production", "PROVIDER_MODE": "mock", "TENANT_ID": "", "API_AUDIENCE": "", "CLIENT_ID": "", "ALLOWED_OBJECT_IDS": "", "TEST_RECIPIENTS": "", "SENDER_EMAIL": "instructions@example.com", "SENDER_NAME": "Event team", "REPLY_TO": "instructions@example.com", "MAX_ATTEMPTS": "3"}
}
