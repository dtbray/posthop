{
  "name": "posthop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:web && pnpm --dir apps/worker exec wrangler dev --local --port 8787",
    "dev:web": "pnpm --dir apps/outlook-addin exec vp dev",
    "build:web": "pnpm --dir apps/outlook-addin exec vp build",
    "build": "pnpm build:web && pnpm --dir apps/worker exec wrangler deploy --dry-run --outdir dist",
    "db:local": "pnpm --dir apps/worker exec wrangler d1 migrations apply posthop --local",
    "types": "pnpm --dir apps/worker exec wrangler types --env-interface CloudflareBindings --strict-vars false",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "manifest:validate": "office-addin-manifest validate apps/outlook-addin/manifest/manifest.xml",
    "test:e2e": "playwright test",
    "format": "vp fmt",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:package": "node scripts/release-package.mjs",
    "check": "vp check --deny-warnings",
    "lint": "vp lint --deny-warnings",
    "format:check": "vp fmt --check",
    "verify": "pnpm verify:static && pnpm test:e2e",
    "verify:static": "pnpm audit --audit-level high && pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.26.0",
    "@fluentui/react-components": "^9.0.0",
    "dompurify": "^3.2.0",
    "jose": "^6.0.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/office-js": "^1.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261019.2-beta",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.7"
}
