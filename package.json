{
  "name": "posthop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm build:web && pnpm --dir apps/worker exec wrangler dev --local --port 8787",
    "dev:web": "pnpm --dir apps/outlook-addin exec vite",
    "build:web": "pnpm --dir apps/outlook-addin exec vite build",
    "build": "pnpm build:web && pnpm --dir apps/worker exec wrangler deploy --dry-run --outdir dist",
    "db:local": "pnpm --dir apps/worker exec wrangler d1 migrations apply posthop --local",
    "types": "pnpm --dir apps/worker exec wrangler types --env-interface CloudflareBindings --strict-vars false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manifest:validate": "office-addin-manifest validate apps/outlook-addin/manifest/manifest.xml",
    "test:e2e": "playwright test",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,css}\" \"apps/**/tests/**/*.ts\" \"packages/**/*.ts\" \"*.{json,ts,yaml}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@azure/msal-browser": "^5.26.0",
    "@fluentui/react-components": "^9.0.0",
    "dompurify": "^3.2.0",
    "jose": "^6.0.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/office-js": "^1.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0",
    "office-addin-manifest": "^2.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.152.0"
  }
}
